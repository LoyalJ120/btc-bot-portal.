PORT=3000
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE
# Generate a random secret of at least 32 characters. Never commit the real value.
PAPER_API_TOKEN=replace-with-a-random-secret-at-least-32-characters
# Optional: path to your database provider's CA certificate (PEM); omit if using a trusted system CA.
# PGSSLROOTCERT=/path/to/database-ca.pem
